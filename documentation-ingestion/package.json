    "remark-parse": "^11.0.0",
    "remark-parse-frontmatter": "^1.0.0",
    "remark-rehype": "^11.1.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
